<!-- Paste inside <dict> in ios/Runner/Info.plist -->
<key>NSLocationWhenInUseUsageDescription</key>
<string>FieldRoute shows your route and checks you in when you arrive at a client site.</string>
<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
<string>FieldRoute records check-in and check-out at client sites, even when the app is in the background.</string>
<key>NSCameraUsageDescription</key>
<string>Take photo proof for visit tasks.</string>
<key>NSPhotoLibraryUsageDescription</key>
<string>Attach photo proof for visit tasks.</string>
<key>UIBackgroundModes</key>
<array>
  <string>location</string>
  <string>remote-notification</string>
</array>

<!--
Also:
 - ios/Podfile: platform :ios, '13.0'
 - Xcode > Runner > Signing & Capabilities: add "Push Notifications" and "Background Modes" (Location updates, Remote notifications)
 - Firebase console > Project settings > Cloud Messaging: upload your APNs key
 - permission_handler needs these flags in the Podfile post_install block
   (inside target.build_configurations.each do |config|):
     config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= ['$(inherited)',
       'PERMISSION_LOCATION=1', 'PERMISSION_LOCATION_ALWAYS=1',
       'PERMISSION_NOTIFICATIONS=1', 'PERMISSION_CAMERA=1']
-->
