rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isAdmin() { return signedIn() && me().role == 'admin'; }

    match /users/{uid} {
      allow read: if signedIn();
      // sign-up creates the user's own profile as a worker only
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.role == 'worker';
      allow update: if isAdmin() ||
        (request.auth.uid == uid && request.resource.data.role == resource.data.role);
    }

    match /routes/{routeId} {
      allow read: if isAdmin() || (signedIn() && resource.data.workerId == request.auth.uid);
      allow create, update, delete: if isAdmin();

      match /stops/{stopId} {
        function ownsRoute() {
          return get(/databases/$(database)/documents/routes/$(routeId)).data.workerId == request.auth.uid;
        }
        allow read: if isAdmin() || (signedIn() && ownsRoute());
        allow create, delete: if isAdmin();
        // the worker may only touch check-in/out, tasks and notes (not the location or radius)
        allow update: if isAdmin() || (signedIn() && ownsRoute() &&
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['lat', 'lng', 'radiusM', 'name', 'target']));
      }
    }

    // each worker writes only their own live location; admins read all
    match /liveLocations/{uid} {
      allow read: if isAdmin();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    match /notifyQueue/{id} {
      allow create: if isAdmin();
      allow read: if signedIn() && (resource.data.toUid == request.auth.uid || isAdmin());
      allow update: if isAdmin() || (signedIn() && resource.data.toUid == request.auth.uid);
      allow delete: if isAdmin();
    }
  }
}
